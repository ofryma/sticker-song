# HTTPS for the real domain. Not active as shipped: copy it into place with the
# domain substituted, which is what `make prod-cert` prints when a certificate
# has been issued —
#
#   sed 's/example.org/stkrmem.com/g' \
#     nginx/conf.d/tls.conf.example > nginx/conf.d/tls.conf
#   make prod-up
#
# It stays an .example in the repo because nginx refuses to start when
# ssl_certificate points at a file that is not there, and a fresh box has no
# certificate until certbot has answered a challenge over plain HTTP.
#
# One canonical address: everything lands on https://example.org. The bare IP
# keeps answering over HTTP through the default server in default.conf, which is
# what an uptime check on the address and the ACME challenge both use.

# Plain HTTP for the named hosts. More specific than default.conf's `_`, so
# nginx picks this for the domain and the app is only ever served over TLS.
server {
    listen 80;
    server_name example.org www.example.org;

    # Renewals answer here, and must not be redirected.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location / { return 301 https://example.org$request_uri; }
}

# www → the bare domain, over TLS so the redirect itself is not a downgrade.
# The certificate covers both names, which is what makes this block possible.
server {
    listen 443 ssl;
    http2 on;
    server_name www.example.org;

    include /etc/nginx/conf.d/tls-params.inc;

    return 301 https://example.org$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name example.org;

    include /etc/nginx/conf.d/tls-params.inc;

    # Six months. Long enough to matter, short enough to back out of within one
    # renewal cycle; no includeSubDomains, so a subdomain stays free to differ,
    # and no preload, which cannot be undone.
    add_header Strict-Transport-Security "max-age=15768000" always;

    include /etc/nginx/conf.d/app.inc;
}
