# Copy to .env and adjust if needed. Every value has a working default,
# so `docker compose up` works even without a .env file.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stickers
POSTGRES_PORT=5442

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stickers
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# App ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Admin API token, for scripts and curl. Empty disables it.
ADMIN_TOKEN=devtoken
# Sign-in for the /admin review page, where drafts are published or rejected.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# How long an /admin sign-in lasts.
ADMIN_SESSION_HOURS=12

# Hold every submission as a draft until a reviewer publishes it. Leave this on.
REQUIRE_REVIEW=true
# Optional. With a key, each draft carries an LLM note for the reviewer; without
# one the draft simply waits. The LLM never publishes or rejects on its own.
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-opus-5

# Longest edge of the thumbnail the wall grid and the collage load.
THUMBNAIL_MAX_EDGE=640

# Votes an image needs before it wins and its exact-name duplicates are DELETED.
DUPLICATE_VOTE_THRESHOLD=20
# pg_trgm similarity (0-1) above which two names are suggested as the same person.
NAME_SIMILARITY_THRESHOLD=0.4
# Every upload is re-encoded into this one format: webp, jpeg or png.
IMAGE_FORMAT=webp
# Encoder quality for webp/jpeg (1-100); ignored for png.
IMAGE_QUALITY=88
# Trust X-Forwarded-For for client IPs. Only safe behind a proxy that overwrites
# the header; see the README.
TRUST_PROXY_HEADERS=true
