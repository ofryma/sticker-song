# Copy to .env on the server, next to docker-compose.prod.yml, and fill in the
# secrets. Unlike development, the passwords have no defaults — compose refuses
# to start without them.

# Images pushed by the GitHub Actions workflow. Pin IMAGE_TAG to a release tag
# (e.g. v1.2.0 or a commit sha) once you stop tracking main.
IMAGE_REPO=ghcr.io/ofryma/sticker-song
IMAGE_TAG=main

# The domain the archive is served on — required. It is the one place the name is
# written: nginx renders its config with it, and the API's CORS allowlist is
# derived from it as https://<domain>. `www.` is handled too, and redirected to
# the bare name. See "Domain and TLS" in README.md.
DOMAIN=example.org

# Host ports for the nginx edge.
HTTP_PORT=80
HTTPS_PORT=443

# Postgres — required.
POSTGRES_USER=stickers
POSTGRES_PASSWORD=
POSTGRES_DB=stickers

# MinIO — MINIO_SECRET_KEY is required.
MINIO_ACCESS_KEY=stickers
MINIO_SECRET_KEY=
MINIO_BUCKET=stickers

# Admin API token, for scripts and curl. Leave empty to disable it.
ADMIN_TOKEN=
# Sign-in for the /admin review page — required, or nothing can be published.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12

# Hold every submission as a draft until a reviewer publishes it.
REQUIRE_REVIEW=true
# Optional LLM note on each draft, for the reviewer. Advisory only.
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-opus-5

# --- small-host tuning -------------------------------------------------------
# The defaults in docker-compose.prod.yml already fit a 1 GB / 1 vCPU box, so
# everything below is only here to be raised on a larger one. See the "Small
# server" section of the README before changing any of it.

# Peak memory during an upload is roughly MAX_IMAGE_MEGAPIXELS x 3 bytes x
# IMAGE_CONCURRENCY. At the defaults that is ~300 MB worst case, which is why
# BACKEND_MEM is what it is. Raise the container before raising these.
MAX_IMAGE_MEGAPIXELS=50
IMAGE_CONCURRENCY=2

# Connection pool ceiling is the sum, and must stay under the Postgres
# max_connections set in docker-compose.prod.yml (20).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Per-container memory. These sum to ~736 MB, leaving the rest of a 1 GB host to
# the kernel and dockerd. On a 4 GB box, roughly quadruple them.
POSTGRES_MEM=160m
MINIO_MEM=224m
BACKEND_MEM=288m
FRONTEND_MEM=24m
NGINX_MEM=40m
# Keep below MINIO_MEM: it is the target Go's collector works against, so it has
# to bite before the kernel's OOM killer does.
MINIO_GOMEMLIMIT=180MiB
MINIO_API_REQUESTS_MAX=32
